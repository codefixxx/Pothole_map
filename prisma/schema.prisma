// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, vector]
}


model User {
  id       String  @id @default(cuid())
  name     String?
  username String? @unique
  email    String  @unique

  role     Role    @default(USER)
  banned   Boolean @default(false)

  // Admin responsibility area
  adminCity String?

  // Potholes reported by this user
  potholes Pothole[]

  // Potholes verified by this admin
  verifiedPotholes Pothole[] @relation("VerifiedBy")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  emailVerified Boolean   @default(false)
  image         String?

  sessions Session[]
  accounts Account[]

  votes    Vote[]
  comments Comment[]

  municipalityMember MunicipalityMember?
  statusHistories    ReportStatusHistory[]
  assignedPotholes   Pothole[]             @relation("CurrentAssignment")
  assignmentsMade     ReportAssignment[]    @relation("AssignedBy")
  assignmentsReceived ReportAssignment[]    @relation("AssignedOfficer")
  notifications       Notification[]
  followedPotholes    ReportFollower[]

  @@map("user")
}

model Pothole {
  id          String   @id @default(cuid())

  title       String
  description String

  latitude    Float
  longitude   Float

  locationAccuracy Float?
  locationSource   LocationSource @default(GPS)
  captureTimestamp DateTime?

  city        String?
  state       String?
  country     String? @default("India")

  imageUrl    String?
  reportImage ReportImage?

  status      Status   @default(PENDING)
  severity    Int      @default(3)

  // Verification tracking
  verifiedAt    DateTime?
  verifiedBy    User?     @relation("VerifiedBy", fields: [verifiedById], references: [id])
  verifiedById  String?

  // Repair tracking
  fixedAt     DateTime?

  // Escalation tracking
  escalated   Boolean   @default(false)
  escalatedAt DateTime?

  // Reporter
  user        User      @relation(fields: [userId], references: [id])
  userId      String

  // Municipality routing
  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

  assignedOfficerId String?
  assignedOfficer   User?              @relation("CurrentAssignment", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  assignments       ReportAssignment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  votes       Vote[]
  comments    Comment[]
  statusHistories ReportStatusHistory[]
  followers       ReportFollower[]
  duplicates      DuplicateCandidate[] @relation("PotholeDuplicates")
  isDuplicateOf   DuplicateCandidate[] @relation("DuplicateOf")

  @@index([city])
  @@index([state])
  @@index([status])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([municipalityId])
  @@index([escalated])
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  VERIFIED
  ONGOING
  FIXED
  REJECTED
}

enum LocationSource {
  GPS
  MANUAL_ADJUSTMENT
}

enum ImageProcessingState {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model ReportImage {
  id              String   @id @default(cuid())
  storageKey      String   @unique
  metadata        Json?
  processingState ImageProcessingState @default(PENDING)
  potholeId       String?  @unique
  pothole         Pothole? @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  embedding       Unsupported("vector(512)")?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("report_image")
}



model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Vote {
  id        String   @id @default(cuid())
  potholeId String
  pothole   Pothole  @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([potholeId, userId])
  @@index([potholeId])
  @@index([userId])
  @@map("vote")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  potholeId String
  pothole   Pothole  @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([potholeId])
  @@index([userId])
  @@map("comment")
}


model Municipality {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      MunicipalityMember[]
  jurisdiction Jurisdiction?
  potholes     Pothole[]

  @@map("municipality")
}

model Jurisdiction {
  id             String       @id @default(cuid())
  name           String
  boundary       Unsupported("geometry(Polygon, 4326)")
  municipalityId String       @unique
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([boundary], name: "jurisdiction_boundary_idx", type: Gist)
  @@map("jurisdiction")
}

model MunicipalityMember {
  id             String           @id @default(cuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  municipalityId String
  municipality   Municipality     @relation(fields: [municipalityId], references: [id], onDelete: Cascade)
  role           MunicipalityRole
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([municipalityId])
  @@map("municipality_member")
}

enum MunicipalityRole {
  OFFICER
  MANAGER
}

model ReportStatusHistory {
  id        String   @id @default(cuid())
  potholeId String
  pothole   Pothole  @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  oldStatus Status
  newStatus Status
  reason    String?
  createdAt DateTime @default(now())

  @@map("report_status_history")
}

model ReportAssignment {
  id           String   @id @default(cuid())
  potholeId    String
  pothole      Pothole  @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  officerId    String
  officer      User     @relation("AssignedOfficer", fields: [officerId], references: [id], onDelete: Cascade)
  assignedById String
  assignedBy   User     @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@map("report_assignment")
}

model DuplicateCandidate {
  id              String          @id @default(cuid())
  potholeId       String
  pothole         Pothole         @relation("PotholeDuplicates", fields: [potholeId], references: [id], onDelete: Cascade)
  duplicateId     String
  duplicate       Pothole         @relation("DuplicateOf", fields: [duplicateId], references: [id], onDelete: Cascade)
  confidenceScore Float
  status          DuplicateStatus @default(POTENTIAL)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([potholeId, duplicateId])
  @@index([potholeId])
  @@index([duplicateId])
  @@map("duplicate_candidate")
}

enum DuplicateStatus {
  POTENTIAL
  CONFIRMED
  REJECTED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([read])
  @@map("notification")
}

model ReportFollower {
  id        String   @id @default(cuid())
  potholeId String
  pothole   Pothole  @relation(fields: [potholeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([potholeId, userId])
  @@index([potholeId])
  @@index([userId])
  @@map("report_follower")
}


