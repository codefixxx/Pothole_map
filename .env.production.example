# =================================================================
# POTHOLEMAP PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =================================================================

# -----------------------------------------------------------------
# 1. APPLICATION & AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------
NODE_ENV=production
BETTER_AUTH_SECRET=your_secure_random_32char_secret_key_here
BETTER_AUTH_BASE_URL=https://potholemap.gov.in

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16 + PostGIS + pgvector)
# -----------------------------------------------------------------
# Connection pool URL (PgBouncer or Supabase transaction pooler)
DATABASE_URL="postgresql://postgres:your_db_password@your_db_host:5432/pothole_map_prod?schema=public&sslmode=require"

# Direct URL for Prisma migrations (bypasses PgBouncer pooler)
DIRECT_URL="postgresql://postgres:your_db_password@your_db_host:5432/pothole_map_prod?schema=public&sslmode=require"

# -----------------------------------------------------------------
# 3. REDIS CONFIGURATION (Upstash / Render / Redis Cloud)
# -----------------------------------------------------------------
REDIS_URL="rediss://default:your_redis_password@your_redis_host:6379"

# -----------------------------------------------------------------
# 4. STORAGE ADAPTER (Uploadthing / S3)
# -----------------------------------------------------------------
UPLOADTHING_SECRET=sk_live_your_uploadthing_secret_key
UPLOADTHING_APP_ID=your_uploadthing_app_id

# -----------------------------------------------------------------
# 5. EMAIL TRANSPORT (Nodemailer / Resend / SendGrid)
# -----------------------------------------------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
EMAIL_FROM="PotholeMap Notifications <notifications@potholemap.gov.in>"

# -----------------------------------------------------------------
# 6. AI EMBEDDING & HUGGINGFACE INFERENCE (Optional microservice)
# -----------------------------------------------------------------
HUGGINGFACE_API_KEY=hf_your_api_token_here
